
import sys
from pathlib import Path
import joblib

from sklearn.linear_model import LogisticRegression
from sklearn.tree import DecisionTreeClassifier
from sklearn.neighbors import KNeighborsClassifier
from sklearn.naive_bayes import GaussianNB
from sklearn.svm import SVC

# Project paths
BASE_DIR = Path(__file__).resolve().parent.parent
NOTEBOOK_DIR = BASE_DIR / "notebooks"
MODEL_DIR = BASE_DIR / "model"

sys.path.insert(0, str(NOTEBOOK_DIR))

# Import preprocessed training data
from data_preprocessing import (
    X_train,
    X_train_scaled,
    y_train,
    MODEL_DIR
)

MODEL_DIR.mkdir(exist_ok=True)

# Define all five models
models = {
    "logistic_regression": (
        LogisticRegression(max_iter=2000, random_state=42),
        X_train_scaled
    ),

    "decision_tree": (
        DecisionTreeClassifier(random_state=42),
        X_train
    ),

    "knn": (
        KNeighborsClassifier(n_neighbors=5),
        X_train_scaled
    ),

    "gaussian_naive_bayes": (
        GaussianNB(),
        X_train
    ),

    "svm": (
        SVC(kernel="rbf", probability=True, random_state=42),
        X_train_scaled
    )
}

# Train and save each model
for filename, (model, X_data) in models.items():

    print(f"\nTraining {filename}...")

    model.fit(X_data, y_train)

    save_path = MODEL_DIR / f"{filename}.joblib"

    joblib.dump(model, save_path, compress=3)

    # Verify that the saved file can be loaded
    loaded_model = joblib.load(save_path)

    print(f"Saved and verified: {save_path.name}")
    print("Classes:", loaded_model.classes_)

print("\nAll five models trained and saved successfully.")
